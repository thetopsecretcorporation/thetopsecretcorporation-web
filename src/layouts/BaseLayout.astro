---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import { getPrimaryNav, siteSettings } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteSettings.siteTitle, description = siteSettings.siteDescription } = Astro.props;
const nav = getPrimaryNav();
const path = Astro.url.pathname;
const isResearchSection = path === '/research/' || path.startsWith('/research/reports/');
const isPmfFieldGuideSection = path === '/pmf-field-guide/' || path.startsWith('/pmf-field-guide/guides/');
const pageClass = path.startsWith('/research/reports/')
  ? 'page-research-report'
  : path === '/research/'
    ? 'page-research'
    : isPmfFieldGuideSection
      ? 'page-pmf-field-guide'
      : 'page-home';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2XM1SDTB9C"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2XM1SDTB9C');
    </script>
  </head>
  <body class={pageClass}>
    <div class="site-shell">
      <header class="header">
        <div class="header-inner">
          <a class="brand" href="/" aria-label={`${siteSettings.siteTitle} home`}>
            <BrandMark />
            <span>{siteSettings.siteTitle}</span>
          </a>

          <nav class="nav" aria-label="Primary navigation" id="site-nav">
            <div class="nav-links">
              {nav.map((item) => (
                <a
                  class:list={['nav-link', item.cta && 'nav-cta', isResearchSection && item.href === '/research/' && 'is-active']}
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  {item.label}
                </a>
              ))}
            </div>
          </nav>

          <button class="mobile-menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav" id="mobile-menu-button">
            <span class="mobile-menu-icon" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </button>
        </div>
      </header>

      <main id={path === '/' ? 'top' : undefined} class="page-content">
        <slot />
      </main>

      <footer class="footer">
        <div class="container footer-inner">
          <span class="footer-copy">{siteSettings.footerLeft}</span>
          <span class="footer-copy">{siteSettings.footerRight}</span>
        </div>
      </footer>
    </div>

    <script is:inline src="/assets/site.js"></script>
    <script is:inline>
      (() => {
        const internalHosts = new Set([
          window.location.hostname,
          'thetopsecretcorporation.com',
          'www.thetopsecretcorporation.com',
        ]);

        document.querySelectorAll('a[href]').forEach((link) => {
          const href = link.getAttribute('href');

          try {
            const url = href?.startsWith('//') ? new URL(`${window.location.protocol}${href}`) : new URL(href || '', window.location.href);

            if ((url.protocol === 'http:' || url.protocol === 'https:') && !internalHosts.has(url.hostname)) {
              link.setAttribute('target', '_blank');
              link.setAttribute('rel', 'noopener noreferrer');
            }
          } catch {
            // Ignore malformed or non-navigational href values.
          }
        });
      })();
    </script>
  </body>
</html>
