---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPmfGuideHref, getPmfPhaseGroups } from '../../lib/pmf-field-guide';
import type { PmfGuideEntry } from '../../lib/pmf-field-guide';

const guideEntries = Object.values(import.meta.glob('../../content/pmfGuides/*.md', { eager: true })) as PmfGuideEntry[];
const phaseGroups = getPmfPhaseGroups(guideEntries);
const phaseNames = Object.keys(phaseGroups);
const phaseOrdinals = ['first', 'second', 'third', 'fourth'];
const getPhaseDisplayName = (phase: string) => phase === 'Go-to-market' ? 'Go-to-Market' : phase;
const getPhaseLabel = (index: number) => `${phaseOrdinals[index] || `Phase ${index + 1}`} phase`;
const getPhaseId = (phase: string) => `pmf-${phase.toLowerCase().replaceAll(' ', '-').replaceAll('/', '-')}-title`;
---
<BaseLayout title="PMF Field Guide | The Top Secret Corporation" description="A punchy 12-guide sequence for founders who need proof of product-market fit, not vibes.">
  <section class="pmf-hero">
    <div class="pmf-hero-media" aria-hidden="true"></div>
    <div class="container pmf-hero-shell">
      <div class="copy-stack pmf-hero-copy">
        <span class="eyebrow">// pmf field guide</span>
        <h1>Find product-market fit without lying to yourself.</h1>
        <p class="hero-body pmf-hero-body">A 12-guide field guide for founders who need proof, not vibes.</p>
        <p class="hero-body pmf-hero-body">Product-market fit means a specific customer keeps using, paying for, and pulling more of your product. Pick one customer, prove the pain, test commitment, deliver the result, then scale only when people come back.</p>
        <div class="pmf-hero-actions" aria-label="PMF Field Guide actions">
          <a class="button button-primary" href="#guides">View guides</a>
          <a class="button button-secondary" href="/pmf-field-guide/guides/define-icp/">Open guide 01.</a>
        </div>
      </div>
    </div>
  </section>

  <section class="pmf-guides-section" id="guides" aria-label="PMF Field Guide guides">
    <div class="container pmf-section-shell">
      <section class="pmf-introduction-panel" aria-labelledby="pmf-introduction-title">
        <div class="pmf-introduction-copy">
          <span class="eyebrow">//intro</span>
          <h2 id="pmf-introduction-title">The field guide</h2>
          <p>Most early startups do not need more theory. They need fewer fake positives: vague ICPs, polite interviews, free beta signups, launch spikes, and demos that never turn into retained customers.</p>
          <p>Use these guides in order:</p>
          <ul class="pmf-introduction-list">
            <li>Start narrow.</li>
            <li>Talk to real customers.</li>
            <li>Find the workaround they already trust.</li>
            <li>Ask for commitment.</li>
            <li>Deliver value by hand when needed.</li>
            <li>Scale only after retention and pull are real.</li>
          </ul>
        </div>
      </section>
      <div class="pmf-curriculum-groups">
        {phaseNames.map((phase, phaseIndex) => (
          <section class="pmf-curriculum-group" aria-labelledby={getPhaseId(phase)}>
            <div class="pmf-group-heading">
              <span class="eyebrow">// {getPhaseLabel(phaseIndex)}</span>
              <h3 id={getPhaseId(phase)}>{getPhaseDisplayName(phase)}</h3>
            </div>
            <ol class="pmf-curriculum-list">
              {phaseGroups[phase].map((guide) => (
                <li class="pmf-curriculum-item">
                  <a class="pmf-curriculum-link" href={getPmfGuideHref(guide)} aria-label={`Open guide ${guide.frontmatter.guideNumber}: ${guide.frontmatter.title}`}>
                    <div class="pmf-curriculum-copy">
                      <div class="pmf-card-topline">
                        <span>Guide {String(guide.frontmatter.guideNumber).padStart(2, '0')}.</span>
                      </div>
                      <h3>{guide.frontmatter.title}</h3>
                      <p>{guide.frontmatter.summary}</p>
                    </div>
                    <div class="pmf-curriculum-deliverable">
                      <span>Guide deliverable</span>
                      <strong>{guide.frontmatter.expectedOutput}</strong>
                    </div>
                    <span class="report-link pmf-curriculum-action">Open guide</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
